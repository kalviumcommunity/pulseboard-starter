# Copy this file to .env and fill in the values for your local setup.

# PostgreSQL connection string (local database created during the course)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulseboard?schema=public"

# Redis connection string (local Redis from the course setup)
REDIS_URL="redis://localhost:6379"

# Any long random string. Used to sign the session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"

# Port the server listens on
PORT=3000
